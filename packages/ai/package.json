{
  "name": "@lint/ai",
  "version": "0.1.0",
  "description": "AI features for Lint — Anthropic SDK wrapper, code review, fix, commit, explain.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsup && tsc -b --emitDeclarationOnly --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "@inquirer/prompts": "^8.4.2",
    "@lint/config": "workspace:*",
    "@lint/core": "workspace:*",
    "@lint/git": "workspace:*",
    "@lint/schemas": "workspace:*",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
