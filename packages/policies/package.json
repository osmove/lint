{
  "name": "@lint/policies",
  "version": "0.1.0",
  "description": "HTTP client for api.lint.to (policies, repositories, commit attempts) + auth credentials.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@lint/config": "workspace:*",
    "@lint/git": "workspace:*",
    "@lint/schemas": "workspace:*",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
