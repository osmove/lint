{
  "name": "@lint/core",
  "version": "0.1.0",
  "description": "Lint orchestration engine — detect, doctor, reporter, parallel run engine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "@lint/config": "workspace:*",
    "@lint/git": "workspace:*",
    "@lint/hooks": "workspace:*",
    "@lint/linters": "workspace:*",
    "@lint/policies": "workspace:*",
    "@lint/schemas": "workspace:*",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "js-yaml": "^4.1.1",
    "nanospinner": "^1.2.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
