{
  "name": "@lint/linters",
  "version": "0.1.0",
  "description": "Linter adapters for Lint (ESLint, Prettier, Biome, Ruff, RuboCop, Stylelint, Pylint, oxlint, erb-lint, Brakeman).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -b --emitDeclarationOnly --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lint/config": "workspace:*",
    "@lint/git": "workspace:*",
    "@lint/schemas": "workspace:*",
    "chalk": "^5.4.1",
    "js-yaml": "^4.2.0",
    "prettier": "^3.8.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
