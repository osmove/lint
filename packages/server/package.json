{
  "name": "@lint/server",
  "version": "0.1.0",
  "description": "Local Lint server — Hono + SSE, exposes the workspace via REST and serves the dashboard UI (Apache-2.0).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx --watch src/dev-server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@hono/node-server": "^1.13.7",
    "@lint/ai": "workspace:*",
    "@lint/config": "workspace:*",
    "@lint/core": "workspace:*",
    "@lint/git": "workspace:*",
    "@lint/hooks": "workspace:*",
    "@lint/linters": "workspace:*",
    "@lint/policies": "workspace:*",
    "@lint/schemas": "workspace:*",
    "hono": "^4.12.25",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "author": "Jimmy Douieb",
  "homepage": "https://lint.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmove/lint.git",
    "directory": "packages/server"
  },
  "keywords": ["lint", "self-hosted", "dashboard", "hono"]
}
