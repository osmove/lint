{
  "name": "@lint/schemas",
  "version": "0.1.0",
  "description": "Zod source-of-truth types for the Lint workspace (LintReport, RunOptions, Policy...).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/", "README.md"],
  "scripts": {
    "build": "tsup && tsc -b --emitDeclarationOnly --force",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
