{
  "name": "lint-monorepo",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:tsc": "tsc -b",
    "clean": "find . -name '*.tsbuildinfo' -delete && find packages -name dist -type d -prune -exec rm -rf {} +",
    "dev": "pnpm --filter lint dev",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter lint test:watch",
    "test:coverage": "pnpm --filter lint test:coverage",
    "lint": "pnpm --filter lint lint",
    "lint:fix": "pnpm --filter lint lint:fix",
    "typecheck": "tsc -b && pnpm --filter @osmove/lint-sdk typecheck && pnpm --filter @lint/dashboard-ui typecheck",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "pack:check": "pnpm --filter lint package:check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
